        {
          "id": "23ba55ac-26d8-4ccf-88ff-6ae7bb3d2db6",
          "name": "List site authors",
          "request": {
            "name": "List site authors",
            "description": {
              "content": "Returned 200 anonymously with X-WP-Total 4 at harvest. This is the standard WordPress author collection; it exposes author display names, slugs, descriptions and avatar URLs (not email addresses) without credentials. Documented here for completeness of the contract only — no response data was captured, no example is provided, and this operation is deliberately excluded from every packaged Agent Skill in this repo. See review.yml.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "wp",
                "v2",
                "users"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "context",
                  "value": "view",
                  "description": "Response shape. Anonymously only `view` and `embed` return data; `edit` requires an authenticated user and returns 401."
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "1",
                  "description": "Current page of the collection, 1-based."
                },
                {
                  "disabled": false,
                  "key": "per_page",
                  "value": "10",
                  "description": "Items per page. Values above 100 return 400 rest_invalid_param, not a clamp."
                },
                {
                  "disabled": false,
                  "key": "_fields",
                  "value": "<string>",
                  "description": "Comma-separated allow-list of top-level response fields."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
