          "name": "Get rendered SEO head metadata for a URL",
          "request": {
            "name": "Get rendered SEO head metadata for a URL",
            "description": {
              "content": "Yoast SEO exposes the rendered <head> block and its structured schema.org graph for any public URL on the site. Anonymously readable at harvest. The same payload is inlined on every post and page as yoast_head / yoast_head_json.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "yoast",
                "v1",
                "get_head"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "url",
                  "value": "<uri>",
                  "description": "(Required) "
                }
              ],
              "variable": []
